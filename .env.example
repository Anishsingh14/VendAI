
# VendAI Environment Variables
# Copy this to backend/.env and fill in your API keys

# Supabase — Project: swyvnonhadvfajdazdlj
SUPABASE_URL=https://swyvnonhadvfajdazdlj.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_FROM_SUPABASE_DASHBOARD
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_FROM_SUPABASE_DASHBOARD

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string

# Gmail SMTP (use an App Password, NOT your regular Gmail password)
# Go to: myaccount.google.com → Security → 2-Step Verification → App Passwords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
